# EditorConfig — https://editorconfig.org
# Enforce indent + line ending consistency across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
