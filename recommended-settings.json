{
  "_comment": "Recommended settings cho user dotclaude plugin. Copy hoặc merge vào ~/.claude/settings.json. Plugin format KHÔNG distribute permissions/env/model — phải copy thủ công. Xem MIGRATION-SETTINGS.md cho hướng dẫn merge. Note: $schema removed vì schema schemastore quá strict cho permission patterns Grep(**)/Read(**) hợp lệ trong Anthropic spec.",
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(yarn --version)",
      "Bash(bun --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(go version)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn typecheck:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:anthropic.com)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(telnet:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/serviceAccount*.json)",
      "Read(**/firebase-adminsdk*.json)",
      "Read(**/gcp-key*.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.next/**/CLAUDE.md",
    "**/dist/**/CLAUDE.md",
    "**/build/**/CLAUDE.md",
    "**/.venv/**/CLAUDE.md"
  ]
}
