{
  "description": "Security reminder hook that warns about potential security issues when editing files",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 && PY=python3 || PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/security_reminder_hook.py\"'"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ]
  }
}
