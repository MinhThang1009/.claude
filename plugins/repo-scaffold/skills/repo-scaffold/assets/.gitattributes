# Normalize line endings to LF (avoid CRLF when developing on Windows with Linux CI/servers).
* text=auto eol=lf
*.sh text eol=lf
# Binary files — leave untouched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary

# Exclude dev/CI files from `git archive` release artifacts (release.yml archives the tree).
# Adjust per project — add tests/ or docs/ here if they should not ship in the release zip.
.github         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
