{
  "env": {
    "//": "Tăng MAX_MCP_OUTPUT_TOKENS để MCP server (như filesystem, GitHub) không bị truncate khi trả về dữ liệu hữu ích. Mặc định 25k (docs MCP), warning threshold 10k.",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "//comment-allow": "Read/Glob/Grep + git read-only forms (status/diff/log/show/blame/branch/rev-parse/ls-files/grep) là Anthropic built-in auto-approved — KHÔNG cần khai báo (xem code.claude.com/docs/en/permissions §Read-only commands). Allow chỉ liệt kê: (1) commands không phải built-in read-only, (2) git write commands thường dùng để skip prompt, (3) dev tooling.",
    "allow": [
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(date:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(yarn --version)",
      "Bash(bun --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(go version)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(claude --version)",
      "Bash(gh --version)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git revert:*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(yarn run *)",
      "Bash(yarn test *)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:anthropic.com)"
    ],
    "//comment-deny": "Deny áp dụng MỌI mode kể cả bypass (per doc 'Removals targeting filesystem root or home directory still prompt as circuit breaker'). Hook bash-guard.sh là defense-in-depth.",
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(telnet:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/serviceAccount*.json)",
      "Read(**/firebase-adminsdk*.json)",
      "Read(**/gcp-key*.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)"
    ],
    "//comment-ask": "Ask cho commands network-affecting (push, install) — user muốn confirm. Bypass mode skip ASK theo doc.",
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(go get:*)",
      "Bash(go install:*)",
      "Bash(brew install:*)"
    ],
    "defaultMode": "acceptEdits",
    "//comment-mode": "acceptEdits = file edits (Edit/Write) tự apply không cần Apply diff card. Bash/WebFetch theo allow/ask/deny rule. Precedence: deny > ask > allow > mode. Per Anthropic doc: 'bypassPermissions skips all permission prompts. Root and home directory removals still prompt as circuit breaker.' — Bypass mode (Shift+Tab) override defaultMode cho session."
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/bash-guard.sh\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/format-on-edit.sh\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null; git rev-parse --git-dir >/dev/null 2>&1 && { echo \"=== Git status ===\"; git status -s; echo \"=== Branch ===\"; git rev-parse --abbrev-ref HEAD; }; exit 0'",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "//": "Statusline custom: hiển thị icon ngưỡng + model + context % + cwd. Script tại hooks/statusline.{py,sh}. Ngưỡng theo Dex Horthy/Boris Cherny — xem docs/REFERENCE.md §16.2. Shebang trong .sh tự handle bash."
  },
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.next/**/CLAUDE.md",
    "**/dist/**/CLAUDE.md",
    "**/build/**/CLAUDE.md",
    "**/.venv/**/CLAUDE.md"
  ],
  "//": "Settings global cho ~/.claude/settings.json. Override bằng settings.json của project khi cần. effortLevel=xhigh persist được; nếu muốn 'max' thì set CLAUDE_CODE_EFFORT_LEVEL=max ở env shell. theme chỉnh qua /config interactive (lưu vào ~/.claude.json), không phải settings.json."
}
