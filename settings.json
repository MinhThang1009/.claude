{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "theme": "light",
  "model": "opus[1m]",
  "//": "Settings global cho ~/.claude/settings.json. Override bằng settings.json của project khi cần.",
  "attribution": {
    "//": "Tắt attribution để commit message không có Co-Authored-By Claude",
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "//": "Mặc định cho global. Project có thể override hoặc thêm allow/deny.",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(yarn --version)",
      "Bash(bun --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(go version)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn typecheck:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Bash(git push:*)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)",
      "WebFetch(*)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget -O - * | bash)",
      "Bash(wget -O - * | sh)",
      "Bash(eval:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  },
  "hooks": {
    "//": "Hook chạy mọi project. Hook đặc thù project đặt trong <project>/.claude/settings.json.",
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash -c 'cmd=\"$CLAUDE_TOOL_INPUT_COMMAND\"; case \"$cmd\" in *\"rm -rf\"*\"/\"*|*\":(){\"*|*\"dd if=\"*) echo \"BLOCKED: dangerous command pattern\" >&2; exit 2;; esac; exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "//": "Auto-format file sau Edit/Write. Mỗi project bật command phù hợp với toolchain.",
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash -c 'f=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.json|*.md|*.yml|*.yaml) command -v prettier >/dev/null 2>&1 && prettier --write \"$f\" 2>/dev/null;; *.py) command -v ruff >/dev/null 2>&1 && ruff format \"$f\" 2>/dev/null;; *.go) command -v gofmt >/dev/null 2>&1 && gofmt -w \"$f\" 2>/dev/null;; *.rs) command -v rustfmt >/dev/null 2>&1 && rustfmt \"$f\" 2>/dev/null;; esac; exit 0'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "//": "Hiển thị git status khi mở session để Claude biết trạng thái repo",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash -c 'cd \"${CLAUDE_PROJECT_DIR:-.}\" && git rev-parse --git-dir >/dev/null 2>&1 && { echo \"=== Git status ===\"; git status -s; echo \"=== Branch ===\"; git rev-parse --abbrev-ref HEAD; }'"
          }
        ]
      }
    ]
  },
  "env": {
    "//": "Tăng MAX_MCP_OUTPUT_TOKENS để MCP server (như filesystem, GitHub) không bị truncate khi trả về dữ liệu hữu ích. Mặc định 10k thường thấp.",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0"
  },
  "autoMemoryEnabled": true,
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.next/**/CLAUDE.md",
    "**/dist/**/CLAUDE.md",
    "**/build/**/CLAUDE.md",
    "**/.venv/**/CLAUDE.md"
  ]
}
