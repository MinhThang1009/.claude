#!/bin/bash
# post-commit hook — sync plugin commands và agents to installed location sau mỗi commit
# Install: cp hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

DOTCLAUDE_ROOT="$(git rev-parse --show-toplevel)"
INSTALL_COMMANDS="$HOME/.claude/commands"
INSTALL_AGENTS="$HOME/.claude/agents"

# Lấy danh sách files thay đổi trong commit vừa rồi
CHANGED_COMMANDS=$(git diff-tree --no-commit-id -r --name-only HEAD 2>/dev/null | grep "plugins/.*/commands/.*\.md$")
CHANGED_AGENTS=$(git diff-tree --no-commit-id -r --name-only HEAD 2>/dev/null | grep "plugins/.*/agents/.*\.md$")

SYNCED=0

if [ -n "$CHANGED_COMMANDS" ]; then
  echo "[post-commit] Syncing plugin commands..."
  for f in $CHANGED_COMMANDS; do
    filename=$(basename "$f")
    src="$DOTCLAUDE_ROOT/$f"
    dst="$INSTALL_COMMANDS/$filename"
    if [ -f "$src" ]; then
      cp "$src" "$dst"
      echo "  ✓ $filename"
      SYNCED=1
    fi
  done
fi

if [ -n "$CHANGED_AGENTS" ]; then
  echo "[post-commit] Syncing plugin agents..."
  for f in $CHANGED_AGENTS; do
    filename=$(basename "$f")
    src="$DOTCLAUDE_ROOT/$f"
    dst="$INSTALL_AGENTS/$filename"
    if [ -f "$src" ]; then
      cp "$src" "$dst"
      echo "  ✓ $filename"
      SYNCED=1
    fi
  done
fi
